def grep_sessions(query, agents, limit=400, per_session=2, max_rows=300,
                  no_cache=False):
    """Body-search collected sessions; one row per match snippet."""
    if not query:
        return []
    pats_b, pat_s = _grep_pats(query)
    hits = []
    for r in collect(agents, limit, no_cache=no_cache):
        grep = GREPPERS.get(r["agent"])
        if grep is None:
            continue
        try:
            snippets = grep(r["id"], pats_b, pat_s, query, per_session)
        except Exception as e:
            print(f"warn: grep {r['agent']}:{r['id']}: {e}", file=sys.stderr)
            continue
        for s in snippets:
            rr = dict(r)
            rr["match"] = s
            rr["title"] = f"{r['title']} ▸ {s}" if r["title"] else s
            hits.append(rr)
        if len(hits) >= max_rows:
            break
    return hits


# ---------------- rm / rename ----------------
def _load_titles():
    try:
        with open(TITLES_PATH, encoding="utf-8") as fh:
            d = json.load(fh)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def _save_titles(d):
    os.makedirs(AX_DATA_DIR, exist_ok=True)
    tmp = TITLES_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(d, fh, ensure_ascii=False, indent=1)
    os.replace(tmp, TITLES_PATH)


def collect(agents, limit, no_cache=False):
    rows = []
    for a in agents:
        try:
            agent_limit = _agent_limit(a, None) if limit is None else limit
            rows.extend(LISTERS[a](limit=agent_limit, no_cache=no_cache))
        except Exception as e:
            print(f"warn: {a}: {e}", file=sys.stderr)
    titles = _load_titles()
    if titles:
        for r in rows:
            t = titles.get(f"{r['agent']}:{r['id']}")
            if t:
                r["title"] = t
    rows.sort(key=lambda r: r["epoch"], reverse=True)
    overall = _overall_limit(limit, agents)
    return rows[:overall]


def fmt_tsv(rows):
    out = []
    for r in rows:
        out.append("\t".join([r["agent"], r["id"], str(r["epoch"]),
                               reltime(r["epoch"]), short_cwd(r["cwd"]),
                               r["cwd"], r["title"]]))
    return "\n".join(out)


def cmd_list(args):
    as_json, agents, limit, no_cache = False, list(AGENTS), None, False
    grep_q = None
    i = 0
    while i < len(args):
        if args[i] == "--json":
            as_json = True
        elif args[i] == "--no-cache":
            no_cache = True
        elif args[i] == "--agent" and i + 1 < len(args):
            i += 1
            agents = [args[i]] if args[i] in AGENTS else []
        elif args[i] == "--limit" and i + 1 < len(args):
            i += 1
            limit = int(args[i])
        elif args[i] == "--grep" and i + 1 < len(args):
            i += 1
            grep_q = args[i]
        i += 1
    if grep_q:
        rows = grep_sessions(grep_q, agents, _overall_limit(limit, agents), no_cache=no_cache)
    else:
        rows = collect(agents, limit, no_cache=no_cache)
    if as_json:
        print(json.dumps(rows, ensure_ascii=False))
    elif rows:
        print(fmt_tsv(rows))


def cmd_preview(args):
    as_json = "--json" in args
    pos = [a for a in args if not a.startswith("-")]
    if len(pos) < 2:
        print("usage: ax preview <agent> <id>", file=sys.stderr)
        return 1
    agent, sid = pos[0], pos[1]
    if agent not in PREVIEWERS:
        print(f"unknown agent: {agent}", file=sys.stderr)
        return 1
    try:
        text = PREVIEWERS[agent](sid)
    except Exception as e:
        text = f"preview error: {e}"
    if as_json:
        print(json.dumps({"agent": agent, "id": sid, "preview": text}, ensure_ascii=False))
    else:
        print(text)


def cmd_resume(args):
    pos = [a for a in args if not a.startswith("-")]
    if len(pos) < 2:
        print("usage: ax resume <agent> <id>", file=sys.stderr)
        return 1
    agent, sid = pos[0], pos[1]
    if agent not in RESUME_CMD:
        print(f"unknown agent: {agent}", file=sys.stderr)
        return 1
    argv = RESUME_CMD[agent](sid)
    cwd = None
    for r in collect([agent], 2000):
        if r["id"] == sid:
            cwd = r["cwd"]
            break
    if cwd and os.path.isdir(cwd):
        os.chdir(cwd)
    print(f"+ cd {os.getcwd()} && {' '.join(argv)}", file=sys.stderr)
    os.execvp(argv[0], argv)


def cmd_agents():
    disabled = set(CONFIG["providers"]["disabled"])
    for a in ALL_AGENTS:
        if a in disabled:
            print(f"{a}: disabled (config)")
            continue
        try:
            info = STORE_INFO[a]()
        except Exception as e:
            print(f"warn: {a}: {e}", file=sys.stderr)
            info = {"ok": False}
        if info.get("ok"):
            print(f"{a}: ok ({info['count']} sessions, {human_size(info['size'])})")
        else:
            print(f"{a}: not found")


def cmd_grep(args):
    if not shutil.which("fzf"):
        print("ax: fzf not found in PATH", file=sys.stderr)
        return 1
    q = " ".join(a for a in args if not a.startswith("-")).strip()
    if not q:
        print("usage: ax grep <query>", file=sys.stderr)
        return 1
    rows = grep_sessions(q, list(AGENTS), 400)
    if not rows:
        print(f"ax: no body hits for: {q}", file=sys.stderr)
        return 1
    fzf = ["fzf", "--delimiter", "\t",
           "--with-nth", "1,4,5,7",
           "--preview", f"{SELF} preview {{1}} {{2}}",
           "--preview-window", "right:55%:wrap",
           "--header", f"grep: {q} | enter=resume ctrl-g=new search ctrl-a=all esc=cancel",
           "--prompt", "grep> ",
           "--bind", f'ctrl-g:become:printf "grep> " > /dev/tty; '
                     f'read q < /dev/tty; exec "{SELF}" grep "$q"',
           "--bind", f'ctrl-a:become:exec "{SELF}"']
    fzf.extend(CONFIG["fzf"]["extra_args"])
    p = subprocess.run(fzf, input=fmt_tsv(rows) + "\n", capture_output=False,
                       text=True, stdout=subprocess.PIPE)
    sel = (p.stdout or "").strip()
    if p.returncode != 0 or not sel:
        return 0
    parts = sel.split("\t")
    return cmd_resume([parts[0], parts[1]])


def _find_session(agent, sid):
    for r in collect([agent], 2000, no_cache=True):
        if r["id"] == sid:
            return r
    return None


def _confirm(prompt, assume_yes):
    if assume_yes:
        return True
    try:
        ans = input(prompt)
    except EOFError:
        print("\nax: aborted (non-interactive stdin; pass --yes to skip)",
              file=sys.stderr)
        return False
    return ans.strip().lower() in ("y", "yes")


def _rm_argv(agent, sid, hard):
    if agent == "devin":
        return ["devin", "rm", "--force", sid]
    if agent == "codex":
        if hard:
            return ["codex", "delete", "--force", sid]
        return ["codex", "archive", sid]
    return None


def cmd_rm(args):
    yes = "--yes" in args or "-y" in args
    hard = "--hard" in args
    pos = [a for a in args if not a.startswith("-")]
    if len(pos) < 2:
        print("usage: ax rm <agent> <id> [--yes] [--hard]", file=sys.stderr)
        return 1
    agent, sid = pos[0], pos[1]
    if agent not in AGENTS:
        print(f"unknown agent: {agent}", file=sys.stderr)
        return 1
    argv = _rm_argv(agent, sid, hard)
    if argv is None:
        print(f"ax: rm not supported for {agent} (supported: devin, codex)",
              file=sys.stderr)
        return 2
    target = _find_session(agent, sid)
    if target is None:
        print(f"ax: {agent} session not found: {sid}", file=sys.stderr)
        return 1
    if not _confirm(f"ax: remove {agent} session {sid} "
                    f"\"{target['title']}\"? [y/N] ", yes):
        print("ax: aborted", file=sys.stderr)
        return 1
    if shutil.which(argv[0]) is None:
        print(f"ax: {argv[0]} not found in PATH", file=sys.stderr)
        return 1
    print(f"+ {' '.join(argv)}", file=sys.stderr)
    p = subprocess.run(argv)
    if p.returncode != 0:
        print(f"warn: {' '.join(argv)} exited {p.returncode}", file=sys.stderr)
    return p.returncode


def cmd_rename(args):
    name, pos, i = None, [], 0
    while i < len(args):
        if args[i] == "--name" and i + 1 < len(args):
            i += 1
            name = args[i]
        elif not args[i].startswith("-"):
            pos.append(args[i])
        i += 1
    if len(pos) < 2 or name is None:
        print('usage: ax rename <agent> <id> --name "new title" '
              '(empty name clears the alias)', file=sys.stderr)
        return 1
    agent, sid = pos[0], pos[1]
    if agent not in AGENTS:
        print(f"unknown agent: {agent}", file=sys.stderr)
        return 1
    if _find_session(agent, sid) is None:
        print(f"ax: {agent} session not found: {sid}", file=sys.stderr)
        return 1
    name = clean_title(name)
    titles = _load_titles()
    key = f"{agent}:{sid}"
    if name:
        titles[key] = name
        _save_titles(titles)
        print(f"ax: {agent} {sid} display title -> {name}")
    else:
        if titles.pop(key, None) is not None:
            _save_titles(titles)
        print(f"ax: {agent} {sid} display title cleared")
    return 0


def cmd_picker():
    if not shutil.which("fzf"):
        print("ax: fzf not found in PATH", file=sys.stderr)
        return 1
    rows = collect(list(AGENTS), None)
    if not rows:
        print("ax: no sessions found", file=sys.stderr)
        return 1
    tsv = fmt_tsv(rows)
    # cols: 1 agent, 2 id, 3 epoch, 4 reltime, 5 short_cwd, 6 cwd, 7 title
    # fzf 0.44: `transform` is unavailable, so ctrl-g re-execs ax via become.
    fzf = ["fzf", "--delimiter", "\t",
           "--with-nth", "1,4,5,7",
           "--preview", f"{SELF} preview {{1}} {{2}}",
           "--preview-window", "right:55%:wrap",
           "--header", "claude/codex/agy/opencode/devin横断 | enter=resume ctrl-g=body-search esc=cancel",
           "--prompt", "ax> ",
           "--bind", f'ctrl-g:become:printf "grep> " > /dev/tty; '
                     f'read q < /dev/tty; exec "{SELF}" grep "$q"']
    fzf.extend(CONFIG["fzf"]["extra_args"])
    p = subprocess.run(fzf, input=tsv + "\n", capture_output=False,
                       text=True, stdout=subprocess.PIPE)
    sel = (p.stdout or "").strip()
    if p.returncode != 0 or not sel:
        return 0
    agent, sid = sel.split("\t")[0], sel.split("\t")[1]
    return cmd_resume([agent, sid])


def main():
    args = sys.argv[1:]
    if not args:
        return cmd_picker()
    cmd, rest = args[0], args[1:]
    if cmd == "list":
        return cmd_list(rest)
    if cmd == "grep":
        return cmd_grep(rest)
    if cmd == "preview":
        return cmd_preview(rest)
    if cmd == "resume":
        return cmd_resume(rest)
    if cmd == "rm":
        return cmd_rm(rest)
    if cmd == "rename":
        return cmd_rename(rest)
    if cmd == "agents":
        return cmd_agents()
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    print(f"unknown command: {cmd}\n{__doc__}", file=sys.stderr)
    return 1


CONFIG = load_config()
AGENTS = _active_agents()

if __name__ == "__main__":
    sys.exit(main() or 0)
