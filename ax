    if not d:
        return {"ok": False}
    count, size = 0, 0
    dbp = os.path.join(d, "sessions.db")
    if os.path.exists(dbp):
        for suffix in ("", "-wal", "-shm"):
            try:
                size += os.path.getsize(dbp + suffix)
            except OSError:
                pass
        con = _goose_db()
        if con is not None:
            try:
                count += con.execute("SELECT COUNT(*) FROM sessions").fetchone()[0]
            except Exception:
                pass
            finally:
                con.close()
    try:
        for fn in os.listdir(d):
            if fn.endswith(".jsonl"):
                count += 1
                try:
                    size += os.path.getsize(os.path.join(d, fn))
                except OSError:
                    pass
    except OSError:
        pass
    if count == 0 and size == 0:
        return {"ok": False}
    return {"ok": True, "count": count, "size": size}


