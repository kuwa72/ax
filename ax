#!/usr/bin/env python3
"""ax - cross-agent session picker for claude / codex / agy / opencode / devin.

Usage:
    ax                      list -> fzf -> resume (in original cwd)
    ax list [--json] [--agent NAME] [--limit N] [--no-cache] [--grep QUERY]
    ax grep <query>         body-search all agents -> fzf -> resume
    ax preview <agent> <id> [--json]
    ax resume <agent> <id>
    ax rm <agent> <id> [--yes] [--hard]   delete a session (devin/codex only)
    ax rename <agent> <id> --name "..."   set an ax-local display title
    ax agents               show provider status, store size and count

Configuration (optional):
    ~/.config/ax/config.toml   (or $XDG_CONFIG_HOME/ax/config.toml)

Local stores only, no network. One provider failing never breaks the others.
Requires: fzf (any recent version; tested with 0.44), python3.
"""
import json
import mmap
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import textwrap
import time

HOME = os.path.expanduser("~")
SELF = os.path.abspath(sys.argv[0])

ALL_AGENTS = ("claude", "codex", "agy", "opencode", "devin")
AGENTS = ALL_AGENTS

DEFAULT_LIMIT = 300
CACHE_DIR = os.path.join(HOME, ".cache", "ax")

# ax-local display-title overrides (`ax rename`). Provider stores are never
# written to, so rename is an ax-side alias that survives across all providers.
AX_DATA_DIR = os.path.join(HOME, ".local", "share", "ax")
TITLES_PATH = os.path.join(AX_DATA_DIR, "titles.json")

PREVIEW_DEFAULTS = {
    "claude": 30,
    "codex": 30,
    "agy": 30,
    "opencode": 30,
    "devin": 20,
}


# ---------------- minimal TOML config parser ----------------
def _default_config():
    return {
        "limits": {
            "max_sessions": DEFAULT_LIMIT,
            "preview_lines": None,
            "max_sessions_per_provider": {},
            "preview_lines_per_provider": {},
        },
        "providers": {"disabled": []},
        "fzf": {"extra_args": []},
    }


def _strip_comment(line):
    quote = None
    escape = False
    out = []
    for c in line:
        if escape:
            out.append(c)
            escape = False
            continue
        if c == "\\" and quote == '"':
            out.append(c)
            escape = True
            continue
        if c == quote:
            quote = None
            out.append(c)
            continue
        if quote is None and c in ('"', "'"):
            quote = c
            out.append(c)
            continue
        if quote is None and c == "#":
            break
        out.append(c)
    return "".join(out).rstrip()


def _unescape_toml(s):
    out = []
    i = 0
    while i < len(s):
        if s[i] == "\\" and i + 1 < len(s):
            c = s[i + 1]
            if c == '"':
                out.append('"')
            elif c == "\\":
                out.append("\\")
            elif c == "n":
                out.append("\n")
            elif c == "t":
                out.append("\t")
            elif c == "r":
                out.append("\r")
            elif c == "b":
                out.append("\b")
            else:
                out.append(s[i])
                out.append(c)
            i += 2
            continue
        out.append(s[i])
        i += 1
    return "".join(out)


def _split_toml_array(s):
    parts = []
    cur = []
    quote = None
    escape = False
    for c in s:
        if escape:
            cur.append(c)
            escape = False
            continue
        if c == "\\" and quote == '"':
            cur.append(c)
            escape = True
            continue
        if quote:
            if c == quote:
                quote = None
            cur.append(c)
            continue
        if c in ('"', "'"):
            quote = c
            cur.append(c)
            continue
        if c == ",":
            parts.append("".join(cur))
            cur = []
            continue
        cur.append(c)
    parts.append("".join(cur))
    return [p.strip() for p in parts if p.strip()]


def _parse_toml_value(s):
    s = s.strip()
    if s.startswith("[") and s.endswith("]"):
        inner = s[1:-1].strip()
        if not inner:
            return []
        parts = _split_toml_array(inner)
        return [_parse_toml_value(p) for p in parts if p]
    if s.startswith('"') and s.endswith('"'):
        return _unescape_toml(s[1:-1])
    if s.startswith("'") and s.endswith("'"):
        return s[1:-1]
    if s == "true":
        return True
    if s == "false":
        return False
    if re.fullmatch(r"-?\d+", s):
        return int(s)
    # bare string / lenient fallback
    return s


def _toml_ensure_table(root, path):
    d = root
    for p in path.split("."):
        if p not in d or not isinstance(d[p], dict):
            d[p] = {}
        d = d[p]
    return d


def _parse_toml(text):
    root = {}
    current = root
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        raw = _strip_comment(lines[i])
        line = raw.strip()
        i += 1
        if not line:
            continue
        if line.startswith("["):
            end = line.find("]")
            if end == -1:
                raise ValueError(f"unclosed section: {line}")
            header = line[1:end].strip()
            current = _toml_ensure_table(root, header)
            continue
        if "=" not in line:
            continue
        key, val = line.split("=", 1)
        key = key.strip()
        val = val.strip()
        if not key:
            continue
        if val.startswith("["):
            while not val.endswith("]"):
                if i >= len(lines):
                    raise ValueError("unclosed array")
                nxt = _strip_comment(lines[i]).strip()
                i += 1
                val += " " + nxt
        current[key] = _parse_toml_value(val)
    return root


def load_config(path=None):
    if path is None:
        config_dir = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
        path = os.path.join(config_dir, "ax", "config.toml")
    cfg = _default_config()
    if not os.path.exists(path):
        return cfg
    try:
        with open(path, "r", encoding="utf-8") as fh:
            raw = _parse_toml(fh.read())
    except Exception as e:
        print(f"warn: config read failed: {path}: {e}", file=sys.stderr)
        return cfg

    limits = raw.get("limits")
    if isinstance(limits, dict):
        ms = limits.get("max_sessions")
        if isinstance(ms, int) and ms > 0:
            cfg["limits"]["max_sessions"] = ms
        elif isinstance(ms, dict):
            per = {}
            for k, v in ms.items():
                if k in ALL_AGENTS and isinstance(v, int) and v > 0:
                    per[k] = v
                else:
                    print(f"warn: config invalid limits.max_sessions.{k}: {v}", file=sys.stderr)
            cfg["limits"]["max_sessions_per_provider"] = per
        elif ms is not None:
            print(f"warn: config invalid limits.max_sessions: {ms}", file=sys.stderr)

        pl = limits.get("preview_lines")
        if isinstance(pl, int) and pl > 0:
            cfg["limits"]["preview_lines"] = pl
        elif isinstance(pl, dict):
            per = {}
            for k, v in pl.items():
                if k in ALL_AGENTS and isinstance(v, int) and v > 0:
                    per[k] = v
                else:
                    print(f"warn: config invalid limits.preview_lines.{k}: {v}", file=sys.stderr)
            cfg["limits"]["preview_lines_per_provider"] = per
        elif pl is not None:
            print(f"warn: config invalid limits.preview_lines: {pl}", file=sys.stderr)
    elif limits is not None:
        print("warn: config limits is not a table", file=sys.stderr)

    providers = raw.get("providers")
    if isinstance(providers, dict):
        disabled = providers.get("disabled")
        if isinstance(disabled, list):
            valid = []
            for d in disabled:
                if isinstance(d, str) and d in ALL_AGENTS:
                    valid.append(d)
                else:
                    print(f"warn: config unknown disabled provider: {d}", file=sys.stderr)
            cfg["providers"]["disabled"] = valid
        elif disabled is not None:
            print(f"warn: config providers.disabled should be a list: {disabled}", file=sys.stderr)
    elif providers is not None:
        print("warn: config providers is not a table", file=sys.stderr)

    fzf = raw.get("fzf")
    if isinstance(fzf, dict):
        extra = fzf.get("extra_args")
        if isinstance(extra, list):
            if all(isinstance(x, str) for x in extra):
                cfg["fzf"]["extra_args"] = extra
            else:
                print("warn: config fzf.extra_args must be a list of strings", file=sys.stderr)
        elif extra is not None:
            print(f"warn: config fzf.extra_args should be a list: {extra}", file=sys.stderr)
    elif fzf is not None:
        print("warn: config fzf is not a table", file=sys.stderr)

    return cfg


def _active_agents():
    disabled = set(CONFIG["providers"]["disabled"])
    return tuple(a for a in ALL_AGENTS if a not in disabled)


def _agent_limit(agent, override):
    if override is not None:
        return override
    per = CONFIG["limits"]["max_sessions_per_provider"]
    return per.get(agent, CONFIG["limits"]["max_sessions"])


def _overall_limit(override, agents):
    if override is not None:
        return override
    return CONFIG["limits"]["max_sessions"]


def _preview_lines(agent, n=None):
    if n is not None:
        return n
    per = CONFIG["limits"]["preview_lines_per_provider"]
    if agent in per:
        return per[agent]
    global_pl = CONFIG["limits"]["preview_lines"]
    if global_pl is not None:
        return global_pl
    return PREVIEW_DEFAULTS[agent]


