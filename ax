    except Exception as e:
        print(f"warn: hermes db: {e}", file=sys.stderr)
        return None


_HERMES_JSON_PREFIX = "\x00json:"


def _hermes_msg_text(content):
    if isinstance(content, str) and content.startswith(_HERMES_JSON_PREFIX):
        try:
            return _text_blocks(json.loads(content[len(_HERMES_JSON_PREFIX):]))
        except Exception:
            return content[len(_HERMES_JSON_PREFIX):]
    if isinstance(content, str):
        return content
    return _text_blocks(content)


def _hermes_first_user(con, sid):
    try:
        row = con.execute(
            "SELECT content FROM messages WHERE session_id=? AND role='user'"
            " ORDER BY rowid LIMIT 1", (sid,)).fetchone()
        if row:
            return clean_title(_hermes_msg_text(row[0]))
    except Exception:
        pass
    return ""


def _hermes_sessions():
    con = _hermes_db()
    if con is None:
        return None, []
    try:
        cols = _table_cols(con, "sessions")
        if "id" not in cols:
            return con, []
        sel = ["id"] + [c for c in ("title", "cwd", "source", "started_at",
                                    "updated_at", "ended_at") if c in cols]
        order = " ORDER BY started_at DESC" if "started_at" in cols else ""
        rows = con.execute(
            f"SELECT {', '.join(sel)} FROM sessions{order}",
            ).fetchall()
        return con, [dict(zip(sel, r)) for r in rows]
    except Exception as e:
        print(f"warn: hermes list: {e}", file=sys.stderr)
        return con, []


def list_hermes(limit=DEFAULT_LIMIT, no_cache=False):
    out = []
    con, rows = _hermes_sessions()
    if con is None:
        return out
    try:
        for r in rows[:limit]:
            epoch = _epoch_from_ts(r.get("started_at")) or \
                _epoch_from_ts(r.get("updated_at"))
            title = (r.get("title") or "").strip()
            if not title:
                title = _hermes_first_user(con, r["id"]) or "(untitled)"
            out.append({"agent": "hermes", "id": r["id"], "epoch": epoch,
                        "cwd": r.get("cwd") or "?", "title": title})
    except Exception as e:
        print(f"warn: hermes list: {e}", file=sys.stderr)
    finally:
        con.close()
    return out


def _hermes_turns(sid):
    con = _hermes_db()
    if con is None:
        return None
    try:
        cols = _table_cols(con, "messages")
        if "session_id" not in cols or "role" not in cols or "content" not in cols:
            return []
        active = " AND active=1" if "active" in cols else ""
        order = " ORDER BY id" if "id" in cols else " ORDER BY rowid"
        rows = con.execute(
            f"SELECT role, content FROM messages WHERE session_id=?{active}{order}",
            (sid,)).fetchall()
        return [(role, _hermes_msg_text(c)) for role, c in rows
                if role in ("user", "assistant")]
    except Exception as e:
        print(f"warn: hermes messages: {e}", file=sys.stderr)
        return []
    finally:
        con.close()


def preview_hermes(sid, n=None, color=None):
