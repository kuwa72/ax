def _devin_lines_to_turns(lines):
    turns = []
    for line in lines or []:
        m = re.match(r"^\[([^\]]+)\]\s(.*)$", line)
        if m:
            turns.append((m.group(1), m.group(2)))
    return turns


def preview_devin(sid, n=None):
    n = _preview_lines("devin", n)
    resume = f"resume: devin -r {sid}"
    local_path = _devin_transcript_path(sid)
    cache_path = _devin_cache_path(sid)

    def _render(total, lines, model, source):
        turns = _devin_lines_to_turns(lines)
        if not turns:
            return None
        info = f"model={model} steps={total} source={source}"
        return render_preview("devin", sid, turns[-n:], total=total,
                              extra=[resume, info])

    # 1. Local ATIF transcript.
    if os.path.exists(local_path):
        try:
            d, lines = _parse_devin_export(local_path)
            out = _render(len(d.get("steps", [])), lines,
                          d.get("agent", {}).get("model_name", "?"), "local")
            if out:
                return out
        except Exception:
            pass

    # 2. Cached export from a previous fallback.
    if os.path.exists(cache_path):
        try:
            d, lines = _parse_devin_export(cache_path)
            out = _render(len(d.get("steps", [])), lines,
                          d.get("agent", {}).get("model_name", "?"), "cache")
            if out:
                return out
        except Exception:
            pass

    # 3. Try devin --export to fetch from the cloud.
    result = _devin_try_export(sid, cache_path, n=n)
    if result:
        model, steps, lines = result
        out = _render(steps, lines, model, "export")
        if out:
            return out

    # 4. Fall back to the local sessions.db message_nodes tree.
    db_result = _devin_db_messages(sid)
    if db_result:
        lines, model = db_result
        out = _render(len(lines), lines, model, "db")
        if out:
            return out

    # 5. Final fallback: show the session title if known.
    title = _devin_title(sid)
    if title:
        return f"--- devin {sid} (0 msgs)\n{resume}\ntitle={title} (no local transcript)"
    return f"--- devin {sid} (0 msgs)\n{resume}\n(no local transcript)"


