# ---------------- grep (body search) ----------------
def _grep_pats(query):
    """(byte patterns for raw-line prefilter, str pattern for extracted text).

    JSONL stores non-ASCII text both raw (UTF-8) and JSON-escaped (\\uXXXX),
    so the byte prefilter checks both forms.
    """
    raw = query.encode("utf-8")
    esc = json.dumps(query, ensure_ascii=True)[1:-1].encode("ascii")
    pats_b = [re.compile(re.escape(raw), re.IGNORECASE)]
    if esc != raw:
        pats_b.append(re.compile(re.escape(esc), re.IGNORECASE))
    return pats_b, re.compile(re.escape(query), re.IGNORECASE)


def _file_might_contain(path, pats_b):
    """Cheap whole-file check via mmap so large transcripts are skipped fast."""
    try:
        with open(path, "rb") as fh:
            try:
                mm = mmap.mmap(fh.fileno(), 0, access=mmap.ACCESS_READ)
            except ValueError:  # empty file
                return False
            try:
                return any(p.search(mm) for p in pats_b)
            finally:
                mm.close()
    except OSError:
        return False


def _snippet(text, pat, width=140):
    t = re.sub(r"\s+", " ", text or "").strip()
    m = pat.search(t)
    if not m:
        return t[:width]
    s = max(0, m.start() - width // 2)
    e = min(len(t), s + width)
    if e - s < width:
        s = max(0, e - width)
    return ("…" if s > 0 else "") + t[s:e] + ("…" if e < len(t) else "")


def _grep_jsonl(path, pats_b, pat_s, extract, max_hits=2):
    """Return up to max_hits snippets from a JSONL transcript.

    `extract(obj)` must return the message-body text only, so metadata-only
    matches (cwd etc.) never produce a hit.
    """
    out = []
    if not path or not os.path.exists(path):
        return out
    if not _file_might_contain(path, pats_b):
        return out
    try:
        with open(path, "rb") as fh:
            for line in fh:
                if not any(p.search(line) for p in pats_b):
                    continue
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                txt = extract(o)
                if txt and pat_s.search(txt):
                    out.append(_snippet(txt, pat_s))
                    if len(out) >= max_hits:
                        break
    except OSError:
        pass
    return out


def _claude_text(o):
    msg = o.get("message", {})
    c = msg.get("content") if isinstance(msg, dict) else None
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return " ".join(b.get("text", "") for b in c
                        if isinstance(b, dict) and b.get("type")
                        in ("text", "input_text", "output_text"))
    return ""


def _codex_text(o):
    pl = o.get("payload") if isinstance(o.get("payload"), dict) else {}
    if pl.get("type") == "user_message" and isinstance(pl.get("message"), str):
        return pl["message"]
    if pl.get("type") == "message":
        return " ".join(b.get("text", "") for b in pl.get("content") or []
                        if isinstance(b, dict) and b.get("type")
                        in ("text", "input_text", "output_text"))
    return ""


def _agy_text(o):
    if o.get("type") in ("USER_INPUT", "AGENT_OUTPUT", "ASSISTANT", "MODEL_OUTPUT"):
        c = o.get("content") or ""
        if isinstance(c, str):
            return re.sub(r"</?USER_REQUEST>|</?ADDITIONAL_METADATA>", " ", c)
    return ""


def grep_claude(sid, pats_b, pat_s, query, max_hits=2):
    return _grep_jsonl(_claude_path(sid), pats_b, pat_s, _claude_text, max_hits)


def grep_codex(sid, pats_b, pat_s, query, max_hits=2):
