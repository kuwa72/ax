        turns = _goose_jsonl_turns(sid)
    if turns is None:
        return f"goose session not found: {sid}"
    resume = f"resume: goose session --resume --session-id {sid}"
    return render_preview("goose", sid, turns[-n:], extra=[resume],
                          total=len(turns), color=color)


# ---------------- omp (oh-my-pi) ----------------
# Sessions: ~/.omp/agent/sessions/<encoded-cwd>/<ts>_<sid>.jsonl
# Current files start with a fixed-width 256-byte type:"title" slot line,
# then a type:"session" header, then append-only entries.
def _omp_root():
    return os.path.join(HOME, ".omp", "agent", "sessions")


def _omp_files():
    root = _omp_root()
    out = []
    if not os.path.isdir(root):
        return out
    for bucket in os.listdir(root):
        b = os.path.join(root, bucket)
        if not os.path.isdir(b):
            continue
        try:
            for fn in os.listdir(b):
                if fn.endswith(".jsonl"):
                    out.append(os.path.join(b, fn))
        except OSError:
            continue
    return out


def _omp_header(path):
    """(header dict, slot title). The header may be line 1 (legacy) or line 2
    (after the fixed-width title slot)."""
    try:
        with open(path, "rb") as fh:
            head = fh.read(8192)
    except OSError:
        return None, ""
    slot_title = ""
    for raw in head.split(b"\n")[:3]:
        try:
            o = json.loads(raw.decode("utf-8", "replace").strip() or "{}")
        except Exception:
            continue
        if not isinstance(o, dict):
            continue
        if o.get("type") == "title":
            slot_title = o.get("title") or ""
        elif o.get("type") == "session":
            return o, slot_title
    return None, slot_title


def _omp_sid(header, path):
    sid = (header or {}).get("id")
    if isinstance(sid, str) and sid:
        return sid
    return os.path.basename(path)[:-len(".jsonl")]


def _omp_file(sid):
    for p in _omp_files():
        if os.path.basename(p)[:-len(".jsonl")] == sid or \
                os.path.basename(p).endswith("_" + sid + ".jsonl"):
            return p
    for p in _omp_files():
        h, _ = _omp_header(p)
        if h and h.get("id") == sid:
            return p
    return None


def _omp_text(o):
    if o.get("type") != "message":
        return ""
    msg = o.get("message") if isinstance(o.get("message"), dict) else {}
    if msg.get("role") not in ("user", "assistant"):
        return ""
    return _text_blocks(msg.get("content"))


def _omp_first_user(path, limit_bytes=65536):
    try:
        with open(path, "rb") as fh:
            for line in fh.read(limit_bytes).split(b"\n"):
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                if isinstance(o, dict) and o.get("type") == "message":
                    t = _omp_text(o)
                    if t and o["message"].get("role") == "user":
                        return t
    except OSError:
        pass
    return ""


def list_omp(limit=DEFAULT_LIMIT, no_cache=False):
    out = []
    for p in _omp_files():
        h, slot_title = _omp_header(p)
        sid = _omp_sid(h, p)
        epoch = _epoch_from_ts((h or {}).get("timestamp"), utc=True)
        if not epoch:
            try:
                epoch = int(os.path.getmtime(p))
            except OSError:
                continue
        title = ((h or {}).get("title") or slot_title or "").strip()
        if not title:
            title = clean_title(_omp_first_user(p)) or "(untitled)"
        out.append({"agent": "omp", "id": sid, "epoch": epoch,
                    "cwd": (h or {}).get("cwd") or "?", "title": title})
    out.sort(key=lambda r: r["epoch"], reverse=True)
    return out[:limit]


def preview_omp(sid, n=None, color=None):
    n = _preview_lines("omp", n)
    p = _omp_file(sid)
    if not p:
        return f"omp session not found: {sid}"
    turns = []
    try:
        with open(p, errors="replace") as fh:
            for line in fh:
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                if isinstance(o, dict) and o.get("type") == "message":
                    t = _omp_text(o)
                    if t:
                        turns.append((o["message"]["role"], t,
                                      o.get("timestamp")))
    except OSError:
        pass
    resume = f"resume: omp --resume {sid}"
    return render_preview("omp", sid, turns[-n:], extra=[resume],
                          total=len(turns), color=color)


# ---------------- vibe (mistral) ----------------
def _vibe_conf():
    root = os.path.join(HOME, ".vibe")
    save_dir = os.path.join(root, "logs", "session")
    prefix = "session"
    cfg_path = os.path.join(root, "config.toml")
    try:
        if os.path.exists(cfg_path):
            with open(cfg_path, encoding="utf-8") as fh:
                raw = _parse_toml(fh.read())
            sl = raw.get("session_logging")
            if isinstance(sl, dict):
                if isinstance(sl.get("save_dir"), str) and sl["save_dir"]:
                    save_dir = os.path.expanduser(sl["save_dir"])
                if isinstance(sl.get("session_prefix"), str) and sl["session_prefix"]:
                    prefix = sl["session_prefix"]
    except Exception:
        pass
    return save_dir, prefix


def _vibe_dirs():
    save_dir, prefix = _vibe_conf()
    out = []
    if not os.path.isdir(save_dir):
        return out
    try:
        for name in os.listdir(save_dir):
            d = os.path.join(save_dir, name)
            if not os.path.isdir(d) or not name.startswith(prefix + "_"):
                continue
            if os.path.exists(os.path.join(d, "messages.jsonl")):
                out.append(d)
    except OSError:
        pass
    return out


def _vibe_meta(d):
    try:
        with open(os.path.join(d, "meta.json"), errors="replace") as fh:
            o = json.load(fh)
        return o if isinstance(o, dict) else {}
    except Exception:
        return {}


def _vibe_sid(d, meta):
    sid = meta.get("session_id")
    if isinstance(sid, str) and sid:
        return sid
    return os.path.basename(d)


def _vibe_dir(sid):
    for d in _vibe_dirs():
        meta = _vibe_meta(d)
        if _vibe_sid(d, meta) == sid or os.path.basename(d) == sid \
                or os.path.basename(d).endswith("_" + sid):
            return d
    return None


def _vibe_text(o):
    if o.get("role") not in ("user", "assistant"):
        return ""
    return _text_blocks(o.get("content"))


def _vibe_first_user(d):
    try:
        with open(os.path.join(d, "messages.jsonl"), "rb") as fh:
            for line in fh.read(65536).split(b"\n"):
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                if isinstance(o, dict) and o.get("role") == "user":
                    t = _vibe_text(o)
                    if t:
                        return t
    except OSError:
        pass
    return ""


def _vibe_cwd(meta):
    env = meta.get("environment") if isinstance(meta.get("environment"), dict) else {}
    return env.get("working_directory") or meta.get("origin_directory") or "?"


def list_vibe(limit=DEFAULT_LIMIT, no_cache=False):
    out = []
    for d in _vibe_dirs():
        meta = _vibe_meta(d)
        try:
            epoch = int(os.path.getmtime(os.path.join(d, "messages.jsonl")))
        except OSError:
            epoch = _epoch_from_ts(meta.get("updated_at"), utc=True)
        title = (meta.get("title") or "").strip() or \
            clean_title(_vibe_first_user(d)) or "(untitled)"
        out.append({"agent": "vibe", "id": _vibe_sid(d, meta), "epoch": epoch,
                    "cwd": _vibe_cwd(meta), "title": title})
    out.sort(key=lambda r: r["epoch"], reverse=True)
    return out[:limit]


def preview_vibe(sid, n=None, color=None):
    n = _preview_lines("vibe", n)
    d = _vibe_dir(sid)
    if not d:
        return f"vibe session not found: {sid}"
    turns = []
    try:
        with open(os.path.join(d, "messages.jsonl"), errors="replace") as fh:
            for line in fh:
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                if isinstance(o, dict):
                    t = _vibe_text(o)
                    if t:
                        turns.append((o["role"], t))
    except OSError:
        pass
    resume = f"resume: vibe --resume {sid}"
    return render_preview("vibe", sid, turns[-n:], extra=[resume],
                          total=len(turns), color=color)


