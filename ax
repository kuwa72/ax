_RM_TTY_AGENTS = {"goose": {"expect": r"delete these sessions", "answer": "y"}}


def _run_tty(argv, expect=None, answer="y", timeout=30):
    """Run argv under a pty; after `expect` appears in output, write `answer`.

    Returns (returncode, combined output). On timeout the child is killed
    and 124 is returned (same convention as timeout(1)).
    """
    import pty
    import select
    import signal

    master, slave = pty.openpty()
    try:
        p = subprocess.Popen(argv, stdin=slave, stdout=slave, stderr=slave,
                             close_fds=True, start_new_session=True)
    except OSError as e:
        os.close(master)
        os.close(slave)
        print(f"warn: {argv[0]}: {e}", file=sys.stderr)
        return 127, ""
    os.close(slave)
    buf = b""
    answered = expect is None
    deadline = time.monotonic() + timeout
    try:
        while True:
            if not answered and expect:
                m = re.search(expect, buf.decode(errors="replace"))
                if m:
                    os.write(master, (answer + "\r").encode())
                    answered = True
            r, _, _ = select.select([master], [], [], 0.1)
            if r:
                try:
                    chunk = os.read(master, 65536)
                except OSError:
                    chunk = b""
                if chunk:
                    buf += chunk
                elif p.poll() is not None:
                    break
            if p.poll() is not None:
                # drain remaining output
                while True:
                    r, _, _ = select.select([master], [], [], 0.1)
                    if not r:
                        break
                    try:
                        chunk = os.read(master, 65536)
                    except OSError:
                        break
                    if not chunk:
                        break
                    buf += chunk
                break
            if time.monotonic() > deadline:
                p.kill()
                p.wait()
                return 124, buf.decode(errors="replace")
    finally:
        try:
            os.close(master)
        except OSError:
            pass
        if p.poll() is None:
            p.kill()
            p.wait()
    return (p.returncode if p.returncode is not None else 124,
            buf.decode(errors="replace"))


def cmd_rm(args):
    yes = "--yes" in args or "-y" in args
    hard = "--hard" in args
    pos = [a for a in args if not a.startswith("-")]
    if len(pos) < 2:
        print("usage: ax rm <agent> <id> [--yes] [--hard]", file=sys.stderr)
        return 1
    agent, sid = pos[0], pos[1]
    if agent not in AGENTS:
        print(f"unknown agent: {agent}", file=sys.stderr)
        return 1
    argv = _rm_argv(agent, sid, hard)
    if argv is None:
        print(f"ax: rm not supported for {agent} "
              f"(supported: devin, codex, goose, opencode)",
              file=sys.stderr)
        return 2
    target = _find_session(agent, sid)
    if target is None:
        print(f"ax: {agent} session not found: {sid}", file=sys.stderr)
        return 1
    if not _confirm(f"ax: remove {agent} session {sid} "
                    f"\"{target['title']}\"? [y/N] ", yes):
        print("ax: aborted", file=sys.stderr)
        return 1
    if shutil.which(argv[0]) is None:
        print(f"ax: {argv[0]} not found in PATH", file=sys.stderr)
        return 1
    print(f"+ {' '.join(argv)}", file=sys.stderr)
    tty = _RM_TTY_AGENTS.get(agent)
    if tty:
        rc, _out = _run_tty(argv, expect=tty["expect"], answer=tty["answer"])
        if rc == 124:
            print(f"warn: {' '.join(argv)} timed out", file=sys.stderr)
        elif rc != 0:
            print(f"warn: {' '.join(argv)} exited {rc}", file=sys.stderr)
        return rc
    p = subprocess.run(argv)
    if p.returncode != 0:
        print(f"warn: {' '.join(argv)} exited {p.returncode}", file=sys.stderr)
    return p.returncode


def cmd_rename(args):
    name, pos, i = None, [], 0
    while i < len(args):
        if args[i] == "--name" and i + 1 < len(args):
            i += 1
            name = args[i]
        elif not args[i].startswith("-"):
            pos.append(args[i])
        i += 1
    if len(pos) < 2 or name is None:
        print('usage: ax rename <agent> <id> --name "new title" '
              '(empty name clears the alias)', file=sys.stderr)
        return 1
    agent, sid = pos[0], pos[1]
    if agent not in AGENTS:
        print(f"unknown agent: {agent}", file=sys.stderr)
        return 1
    if _find_session(agent, sid) is None:
        print(f"ax: {agent} session not found: {sid}", file=sys.stderr)
        return 1
    name = clean_title(name)
    titles = _load_titles()
    key = f"{agent}:{sid}"
    if name:
        titles[key] = name
        _save_titles(titles)
        print(f"ax: {agent} {sid} display title -> {name}")
    else:
        if titles.pop(key, None) is not None:
            _save_titles(titles)
        print(f"ax: {agent} {sid} display title cleared")
    return 0


# fzf 0.44-compatible ctrl-d binding: re-exec ax rm on the selected row.
# No --yes — ax's own confirm prompt still runs (see cmd_rm).
_PICKER_HEADER_SUFFIX = "ctrl-d=delete"
_GREP_HEADER_SUFFIX = "ctrl-d=delete"


def _picker_delete_bind(rm_agents):
    """Build the fzf `ctrl-d:become` argv piece that re-execs ax rm.

    fzf replaces {1} {2} with the selected row's agent and id columns.
    After ax rm returns, the picker restarts so the list reflects the
    deletion.
    """
    return ["--bind",
            f'ctrl-d:become:exec "{SELF}" rm {{1}} {{2}}; '
            f'exec "{SELF}"']


def cmd_picker():
    if not shutil.which("fzf"):
        print("ax: fzf not found in PATH", file=sys.stderr)
        return 1
    rows = collect(list(AGENTS), None)
    if not rows:
        print("ax: no sessions found", file=sys.stderr)
        return 1
    tsv = fmt_tsv(rows)
    # cols: 1 agent, 2 id, 3 epoch, 4 reltime, 5 short_cwd, 6 cwd, 7 title
    # fzf 0.44: `transform` is unavailable, so ctrl-g re-execs ax via become.
    fzf = ["fzf", "--delimiter", "\t", "--ansi",
           "--with-nth", "1,4,5,7",
           "--preview", f"{SELF} preview {{1}} {{2}}",
           "--preview-window", "right:55%:wrap",
           "--header", f"{'/'.join(AGENTS)} | enter=resume ctrl-g=body-search "
                       f"{_PICKER_HEADER_SUFFIX} esc=cancel",
           "--prompt", "ax> ",
           "--bind", f'ctrl-g:become:printf "grep> " > /dev/tty; '
                     f'read q < /dev/tty; exec "{SELF}" grep "$q"',
           *_picker_delete_bind(AGENTS)]
    fzf.extend(CONFIG["fzf"]["extra_args"])
    env = os.environ.copy()
    env["AX_PREVIEW_COLOR"] = "1"
    p = subprocess.run(fzf, input=tsv + "\n", capture_output=False,
                       text=True, stdout=subprocess.PIPE, env=env)
    sel = (p.stdout or "").strip()
    if p.returncode != 0 or not sel:
        return 0
    agent, sid = sel.split("\t")[0], sel.split("\t")[1]
    return cmd_resume([agent, sid])


def main():
    args = sys.argv[1:]
    if not args:
        return cmd_picker()
    cmd, rest = args[0], args[1:]
    if cmd == "list":
        return cmd_list(rest)
    if cmd == "grep":
        return cmd_grep(rest)
    if cmd == "preview":
        return cmd_preview(rest)
    if cmd == "resume":
        return cmd_resume(rest)
    if cmd == "rm":
        return cmd_rm(rest)
    if cmd == "rename":
        return cmd_rename(rest)
    if cmd == "agents":
        return cmd_agents()
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    print(f"unknown command: {cmd}\n{__doc__}", file=sys.stderr)
    return 1


CONFIG = load_config()
AGENTS = _active_agents()

if __name__ == "__main__":
    sys.exit(main() or 0)
