def grep_opencode(sid, pats_b, pat_s, query, max_hits=2):
    out = []
    try:
        con = _oc_db()
        if con is None:
            return out
        # LIKE is ASCII case-insensitive; ESCAPE makes %_ in the query literal.
        # Match the JSON-escaped form too (data may store non-ASCII as \uXXXX).
        def _like(q):
            return "%" + re.sub(r"([%_\\])", r"\\\1", q) + "%"
        likes = [_like(query)]
        esc = json.dumps(query, ensure_ascii=True)[1:-1]
        if esc != query:
            likes.append(_like(esc))
        where = " OR ".join("data LIKE ? ESCAPE '\\'" for _ in likes)
        rows = con.execute(
            f"SELECT data FROM part WHERE session_id=? AND ({where}) LIMIT ?",
            (sid, *likes, max_hits * 8)).fetchall()
        con.close()
    except Exception:
        return out
    for (d,) in rows:
        try:
            o = json.loads(d) if isinstance(d, str) else d
        except Exception:
            continue
        if not isinstance(o, dict) or o.get("type") != "text":
            continue
        txt = o.get("text")
        if isinstance(txt, str) and pat_s.search(txt):
            out.append(_snippet(txt, pat_s))
            if len(out) >= max_hits:
                break
    return out


def grep_devin(sid, pats_b, pat_s, query, max_hits=2):
    p = _devin_transcript_path(sid)
    out = []
    if not os.path.exists(p) or not _file_might_contain(p, pats_b):
        return out
    try:
        with open(p, errors="replace") as fh:
            d = json.load(fh)
    except Exception:
        return out
    steps = d.get("steps", []) if isinstance(d, dict) else []
    for s in steps:
        if not isinstance(s, dict) or s.get("source") in ("system",):
            continue
        txt = str(s.get("message", "") or "")
        if pat_s.search(txt):
            out.append(_snippet(txt, pat_s))
            if len(out) >= max_hits:
                break
    return out


