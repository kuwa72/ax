def reltime(epoch):
    d = int(time.time() - epoch)
    if d < 60:
        return "just now"
    if d < 3600:
        return f"{d // 60}m ago"
    if d < 86400:
        return f"{d // 3600}h ago"
    if d < 86400 * 30:
        return f"{d // 86400}d ago"
    t = time.localtime(epoch)
    return f"{t.tm_year}-{t.tm_mon:02d}-{t.tm_mday:02d}"


def short_cwd(cwd):
    if not cwd or cwd == "?":
        return "?"
    if cwd.startswith(HOME):
        cwd = "~" + cwd[len(HOME):]
    parts = cwd.rstrip("/").split("/")
    if len(parts) > 3:
        return "/".join(parts[:2] + ["...", parts[-1]])
    return cwd


NOISE_TAGS = ("<environment_context>", "<command-name>", "<command-message>",
              "<command-args>", "<local-command-caveat>", "<<ccr:")


def clean_title(s, n=80):
    s = re.sub(r"\s+", " ", (s or "")).strip()
    for tag in NOISE_TAGS:
        if tag in s:
            return ""
    return s[:n]


def body_text(s):
    """Message body for preview: stripped, '' if it is machine noise."""
    s = (s or "").strip()
    for tag in NOISE_TAGS:
        if tag in s:
            return ""
    return s


def human_size(n):
    if n < 1024:
        return f"{n} B"
    for unit in ("kB", "MB", "GB", "TB"):
        n /= 1024.0
        if n < 1024:
            s = f"{n:.1f}".rstrip("0").rstrip(".")
            return f"{s} {unit}"
    return f"{n:.1f} PB"


# ---------------- preview formatting ----------------
def _role_label(role):
    r = (role or "").strip().lower()
    if r == "user":
        return "user"
    if r in ("assistant", "ai", "agent", "model"):
        return "ai"
    return r or "msg"


def fmt_ts(ts):
    """Best-effort 'YYYY-MM-DD HH:MM' from epoch s/ms or an ISO string."""
    if ts is None or ts == "":
        return ""
    if isinstance(ts, (int, float)):
        epoch = ts / 1000 if ts > 1e11 else ts
        return time.strftime("%Y-%m-%d %H:%M", time.localtime(epoch))
    return str(ts).strip().replace("T", " ")[:16]


def _wrap_width():
    try:
        w = int(os.environ.get("AX_PREVIEW_WIDTH", "0"))
    except ValueError:
        w = 0
    if w <= 0:
        w = min(shutil.get_terminal_size((80, 24)).columns, 80)
    return max(w, 20)


def wrap_body(text, width):
    """Word-wrap each line at width, preserving original newlines."""
    out = []
    for line in (text or "").split("\n"):
        if not line.strip():
            out.append("")
            continue
        out.extend(textwrap.wrap(line, width=width, break_long_words=False,
                                 break_on_hyphens=False) or [""])
    return out


def render_preview(agent, sid, turns, extra=(), width=0, total=None):
    """turns: [(role, text) or (role, text, ts)] -> '--- agent id' header plus
    blank-line-separated '[role] <ts>' / wrapped-body blocks."""
    width = width or _wrap_width()
    lines = [f"--- {agent} {sid} ({len(turns) if total is None else total} msgs)"]
    lines.extend(extra)
    for t in turns:
        ts = fmt_ts(t[2]) if len(t) > 2 else ""
        lines.append("")
        lines.append(f"[{_role_label(t[0])}]" + (f" {ts}" if ts else ""))
        lines.extend(wrap_body(t[1], width))
    if not turns:
        lines.append("(no messages)")
    return "\n".join(lines)


# ---------------- claude ----------------
def _claude_path(sid):
    root = os.path.join(HOME, ".claude", "projects")
    if not os.path.isdir(root):
        return None
    with os.scandir(root) as it:
        for proj in it:
            if not proj.is_dir():
                continue
            p = os.path.join(proj.path, sid + ".jsonl")
            if os.path.exists(p):
                return p
    return None


def list_claude(limit=DEFAULT_LIMIT, no_cache=False):
    out = []
    root = os.path.join(HOME, ".claude", "projects")
    if not os.path.isdir(root):
        return out
    files = []
    with os.scandir(root) as it:
        for proj in it:
            if not proj.is_dir():
                continue
            try:
                with os.scandir(proj.path) as it2:
                    for f in it2:
                        if f.name.endswith(".jsonl"):
                            files.append((f.stat().st_mtime, f.path))
            except OSError:
                continue
    files.sort(reverse=True)
    for mtime, path in files[:limit]:
        sid = os.path.basename(path)[:-6]
        cwd, title = "?", ""
        try:
            with open(path, errors="replace") as fh:
                for i, line in enumerate(fh):
                    if i > 200:
                        break
                    try:
                        o = json.loads(line)
                    except Exception:
                        continue
                    if not cwd or cwd == "?":
                        c = o.get("cwd")
                        if c:
                            cwd = c
                    if not title and o.get("type") == "user":
                        msg = o.get("message", {})
                        content = msg.get("content") if isinstance(msg, dict) else None
                        if isinstance(content, str):
                            title = clean_title(content)
                        elif isinstance(content, list):
                            for b in content:
                                if isinstance(b, dict) and b.get("type") in ("text", "input_text"):
                                    t = clean_title(b.get("text", ""))
                                    if t:
                                        title = t
                                        break
                    if cwd != "?" and title:
                        break
        except OSError:
            continue
        out.append({"agent": "claude", "id": sid, "epoch": int(mtime),
                    "cwd": cwd, "title": title or "(no preview)"})
    return out


def preview_claude(sid, n=None):
    n = _preview_lines("claude", n)
    path = _claude_path(sid)
    if not path:
        return f"claude session not found: {sid}"
    turns = []
    with open(path, errors="replace") as fh:
        for line in fh:
            try:
                o = json.loads(line)
            except Exception:
                continue
            t = o.get("type")
            if t == "user":
                msg = o.get("message", {})
                c = msg.get("content") if isinstance(msg, dict) else None
                txt = c if isinstance(c, str) else "\n".join(
                    b.get("text", "") for b in c if isinstance(b, dict) and "text" in b) \
                    if isinstance(c, list) else ""
                txt = body_text(txt)
                if txt:
                    turns.append(("user", txt, o.get("timestamp")))
            elif t == "assistant":
                msg = o.get("message", {})
                c = msg.get("content") if isinstance(msg, dict) else None
                if isinstance(c, list):
                    for b in c:
                        if isinstance(b, dict) and b.get("type") == "text" and b.get("text"):
                            txt = body_text(b["text"])
                            if txt:
                                turns.append(("ai", txt, o.get("timestamp")))
                            break
    return render_preview("claude", sid, turns[-n:], total=len(turns))


# ---------------- codex ----------------
def _codex_path(sid):
    root = os.path.join(HOME, ".codex", "sessions")
    if not os.path.isdir(root):
        return None
    for dp, _, fns in os.walk(root):
        for fn in fns:
            if sid in fn and fn.endswith(".jsonl"):
                return os.path.join(dp, fn)
    return None


def list_codex(limit=DEFAULT_LIMIT, no_cache=False):
    out = []
    root = os.path.join(HOME, ".codex", "sessions")
    if not os.path.isdir(root):
        return out
    files = []
    for dp, _, fns in os.walk(root):
        for fn in fns:
            if fn.endswith(".jsonl"):
                p = os.path.join(dp, fn)
                try:
                    files.append((os.path.getmtime(p), p))
                except OSError:
                    pass
    files.sort(reverse=True)
    for mtime, path in files[:limit]:
        sid, cwd, title = None, "?", ""
        try:
            with open(path, errors="replace") as fh:
                for i, line in enumerate(fh):
                    if i > 120:
                        break
                    try:
                        o = json.loads(line)
                    except Exception:
                        continue
                    pl = o.get("payload", {}) if isinstance(o.get("payload"), dict) else {}
                    if o.get("type") == "session_meta":
                        sid = pl.get("id") or sid
                        cwd = pl.get("cwd") or cwd
                    elif not title and o.get("type") == "event_msg" \
                            and pl.get("type") == "user_message":
                        title = clean_title(pl.get("message", ""))
                    elif not title and o.get("type") == "response_item" \
                            and pl.get("role") == "user":
                        for b in pl.get("content", []) or []:
                            if isinstance(b, dict) and b.get("type") == "input_text":
                                t = clean_title(b.get("text", ""))
                                if t:
                                    title = t
                                    break
                    if sid and cwd != "?" and title:
                        break
        except OSError:
            continue
        out.append({"agent": "codex", "id": sid or os.path.basename(path),
                    "epoch": int(mtime), "cwd": cwd, "title": title or "(no preview)"})
    return out


def preview_codex(sid, n=None):
    n = _preview_lines("codex", n)
    target = _codex_path(sid)
    if not target:
        return f"codex session not found: {sid}"
    turns = []
    with open(target, errors="replace") as fh:
        for line in fh:
            try:
                o = json.loads(line)
            except Exception:
                continue
            pl = o.get("payload", {}) if isinstance(o.get("payload"), dict) else {}
            if o.get("type") == "event_msg" and pl.get("type") == "user_message":
                txt = body_text(pl.get("message", ""))
                if txt:
                    turns.append(("user", txt, o.get("timestamp")))
            elif o.get("type") == "response_item" and pl.get("type") == "message":
                role = pl.get("role", "?")
                txt = ""
                for b in pl.get("content", []) or []:
                    if isinstance(b, dict) and b.get("type") in ("output_text", "input_text"):
                        txt += b.get("text", "")
                txt = body_text(txt)
                if txt and role != "user":
                    turns.append(("ai", txt, o.get("timestamp")))
    return render_preview("codex", sid, turns[-n:], total=len(turns))


# ---------------- agy (antigravity cli) ----------------
AGY_HOME = os.path.join(HOME, ".gemini", "antigravity-cli")


def _agy_transcript(cid):
    return os.path.join(AGY_HOME, "brain", cid, ".system_generated", "logs",
                        "transcript.jsonl")


def _agy_history():
    """conversationId -> [best_title, workspace, max_ts_ms]."""
    m = {}
    p = os.path.join(AGY_HOME, "history.jsonl")
    if not os.path.exists(p):
        return m
    with open(p, errors="replace") as fh:
        for line in fh:
            try:
                o = json.loads(line)
            except Exception:
                continue
            cid = o.get("conversationId")
            if not cid:
                continue
            disp = clean_title(re.sub(r"</?USER_REQUEST>", " ", o.get("display") or ""))
            ws = o.get("workspace", "?") or "?"
            ts = o.get("timestamp", 0) or 0
            cur = m.get(cid)
            if cur is None:
                m[cid] = [disp if not disp.startswith("/") else "", ws, ts]
            else:
                if ws != "?":
                    cur[1] = ws
                cur[2] = max(cur[2], ts)
                if disp and not disp.startswith("/") and len(disp) > len(cur[0]):
                    cur[0] = disp
    return m


def list_agy(limit=DEFAULT_LIMIT, no_cache=False):
    out = []
    conv = os.path.join(AGY_HOME, "conversations")
    if not os.path.isdir(conv):
        return out
    hist = _agy_history()
    lastmap = {}
    try:
        with open(os.path.join(AGY_HOME, "cache", "last_conversations.json")) as fh:
            lastmap = {v: k for k, v in json.load(fh).items()}
    except Exception:
        pass
    dbs = []
    with os.scandir(conv) as it:
        for f in it:
            if f.name.endswith(".db"):
                try:
                    dbs.append((f.stat().st_mtime, f.path, f.name[:-3]))
                except OSError:
                    pass
    dbs.sort(reverse=True)
    for mtime, dbp, cid in dbs[:limit]:
        h = hist.get(cid, ("", "?", 0))
        title, cwd, hts = h
        epoch = int(max(mtime, (hts or 0) / 1000))
        if cwd == "?" or not cwd:
            try:
                con = sqlite3.connect(f"file:{dbp}?mode=ro", uri=True)
                row = con.execute(
                    "SELECT data FROM trajectory_metadata_blob LIMIT 1").fetchone()
                con.close()
                if row and row[0]:
                    m_ = re.search(rb"file://([^\x00-\x1f\"']+)", bytes(row[0]))
                    if m_:
                        cwd = m_.group(1).decode("utf-8", "replace")
            except Exception:
                pass
        if (not cwd or cwd == "?") and cid in lastmap:
            cwd = lastmap[cid]
        if not title:
            title = _agy_first_input(cid)
        out.append({"agent": "agy", "id": cid, "epoch": epoch,
                    "cwd": cwd or "?", "title": title or "(no preview)"})
    return out


def _agy_first_input(cid):
    p = _agy_transcript(cid)
    if not os.path.exists(p):
        return ""
    try:
        with open(p, errors="replace") as fh:
            for i, line in enumerate(fh):
                if i > 40:
                    break
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                if o.get("type") == "USER_INPUT" and o.get("content"):
                    c = clean_title(re.sub(r"</?USER_REQUEST>", " ", o["content"]))
                    if c and not c.startswith("/"):
                        return c
    except OSError:
        pass
    return ""


def preview_agy(cid, n=None):
