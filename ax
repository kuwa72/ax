def cmd_grep(args):
    if not shutil.which("fzf"):
        print("ax: fzf not found in PATH", file=sys.stderr)
        return 1
    agents, limit, pos = list(AGENTS), 400, []
    i = 0
    while i < len(args):
        if args[i] == "--agent" and i + 1 < len(args):
            i += 1
            agents = [args[i]] if args[i] in AGENTS else []
        elif args[i] == "--limit" and i + 1 < len(args):
            i += 1
            limit = int(args[i])
        elif not args[i].startswith("-"):
            pos.append(args[i])
        i += 1
    q = " ".join(pos).strip()
    if not q:
        print("usage: ax grep <query> [--agent NAME] [--limit N]",
              file=sys.stderr)
        return 1
    if not agents:
        return 0
    rows = grep_sessions(q, agents, limit)
    if not rows:
        print(f"ax: no body hits for: {q}", file=sys.stderr)
        return 1
    filt = ""
    if len(agents) == 1:
        filt += f" --agent {agents[0]}"
    if limit != 400:
        filt += f" --limit {limit}"
    fzf = ["fzf", "--delimiter", "\t", "--ansi",
           "--with-nth", "1,4,5,7",
           "--preview", f"{SELF} preview {{1}} {{2}}",
           "--preview-window", "right:55%:wrap",
           "--header", f"grep: {q} | enter=resume ctrl-g=new search ctrl-a=all "
                       f"{_GREP_HEADER_SUFFIX} esc=cancel",
           "--prompt", "grep> ",
           "--bind", f'ctrl-g:become:printf "grep> " > /dev/tty; '
                     f'read q < /dev/tty; exec "{SELF}" grep{filt} "$q"',
           "--bind", f'ctrl-a:become:exec "{SELF}"',
           *_picker_delete_bind(AGENTS)]
    fzf.extend(CONFIG["fzf"]["extra_args"])
    env = os.environ.copy()
    env["AX_PREVIEW_COLOR"] = "1"
    p = subprocess.run(fzf, input=fmt_tsv(rows) + "\n", capture_output=False,
                       text=True, stdout=subprocess.PIPE, env=env)
    sel = (p.stdout or "").strip()
    if p.returncode != 0 or not sel:
        return 0
    parts = sel.split("\t")
    return cmd_resume([parts[0], parts[1]])


def _find_session(agent, sid):
    for r in collect([agent], 2000, no_cache=True):
        if r["id"] == sid:
            return r
    return None


def _confirm(prompt, assume_yes):
    if assume_yes:
        return True
    try:
        ans = input(prompt)
    except EOFError:
        print("\nax: aborted (non-interactive stdin; pass --yes to skip)",
              file=sys.stderr)
        return False
    return ans.strip().lower() in ("y", "yes")


def _rm_argv(agent, sid, hard):
    if agent == "devin":
        return ["devin", "rm", "--force", sid]
    if agent == "codex":
        if hard:
            return ["codex", "delete", "--force", sid]
        return ["codex", "archive", sid]
    if agent == "goose":
        # goose session remove has no --yes flag; it shows an interactive
        # confirm dialog that needs a tty. _run_tty() answers it after ax's
        # own confirmation has already passed.
        return ["goose", "session", "remove", "--session-id", sid]
    if agent == "opencode":
        return ["opencode", "session", "delete", sid]
    return None


