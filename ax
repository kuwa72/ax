def _goose_dir():
    cands = []
    xdg = os.environ.get("XDG_DATA_HOME")
    if xdg:
        cands.append(os.path.join(xdg, "goose", "sessions"))
    cands += [os.path.join(HOME, ".local", "share", "goose", "sessions"),
              os.path.join(HOME, ".config", "goose", "sessions")]
    for d in cands:
        if os.path.isdir(d):
            return d
    return None


def _goose_db():
    d = _goose_dir()
    if not d:
        return None
    p = os.path.join(d, "sessions.db")
    if not os.path.exists(p):
        return None
    try:
        return sqlite3.connect(f"file:{p}?mode=ro", uri=True)
    except Exception as e:
        print(f"warn: goose db: {e}", file=sys.stderr)
        return None


def _goose_msg_text(content):
    try:
        o = json.loads(content) if isinstance(content, str) else content
    except Exception:
        return content if isinstance(content, str) else ""
    return _text_blocks(o)


def _goose_db_sessions(limit):
    """[(id, epoch, cwd, title)] from sessions.db; schema columns are probed
    because they accreted across goose releases."""
    out = []
    con = _goose_db()
    if con is None:
        return out
    try:
        cols = _table_cols(con, "sessions")
        if "id" not in cols:
            return out
        sel = ["id"] + [c for c in ("working_dir", "name", "description",
                                    "created_at", "updated_at") if c in cols]
        where = " WHERE archived_at IS NULL" if "archived_at" in cols else ""
        order = " ORDER BY updated_at DESC" if "updated_at" in cols else \
            (" ORDER BY created_at DESC" if "created_at" in cols else "")
        q = f"SELECT {', '.join(sel)} FROM sessions{where}{order} LIMIT ?"
        for row in con.execute(q, (limit,)):
            r = dict(zip(sel, row))
            epoch = (_epoch_from_ts(r.get("updated_at"), utc=True)
                     or _epoch_from_ts(r.get("created_at"), utc=True))
            title = (r.get("name") or r.get("description") or "").strip()
            out.append((r["id"], epoch, r.get("working_dir") or "?",
                        title or "(untitled)"))
    except Exception as e:
        print(f"warn: goose list: {e}", file=sys.stderr)
    finally:
        con.close()
    return out


def _goose_jsonl_sessions(exclude_ids):
    """Legacy pre-1.10 *.jsonl files: line 1 is a metadata header, the rest
    are message objects {role, content:[...]}."""
    d = _goose_dir()
    out = []
    if not d:
        return out
    try:
        names = [f for f in os.listdir(d) if f.endswith(".jsonl")]
    except OSError:
        return out
    for fn in names:
        sid = fn[:-len(".jsonl")]
        if sid in exclude_ids:
            continue
        p = os.path.join(d, fn)
        try:
            with open(p, errors="replace") as fh:
                head = json.loads(fh.readline() or "{}")
            epoch = (_epoch_from_ts(head.get("updated_at"), utc=True)
                     or _epoch_from_ts(head.get("created_at"), utc=True)
                     or int(os.path.getmtime(p)))
            title = (head.get("description") or head.get("name") or "").strip()
            out.append((sid, epoch, head.get("working_dir") or "?",
                        title or "(untitled)"))
        except Exception:
            continue
    return out


def list_goose(limit=DEFAULT_LIMIT, no_cache=False):
    rows = _goose_db_sessions(limit)
    ids = {r[0] for r in rows}
    rows += [r for r in _goose_jsonl_sessions(ids)]
    rows.sort(key=lambda r: r[1], reverse=True)
    return [{"agent": "goose", "id": sid, "epoch": epoch, "cwd": cwd,
             "title": title} for sid, epoch, cwd, title in rows[:limit]]


def _goose_db_turns(sid):
    con = _goose_db()
    if con is None:
        return None
    try:
        cols = _table_cols(con, "messages")
        ccol = "content_json" if "content_json" in cols else \
            ("content" if "content" in cols else None)
        if "session_id" not in cols or "role" not in cols or not ccol:
            return []
        rows = con.execute(
            f"SELECT role, {ccol} FROM messages WHERE session_id=?"
            " ORDER BY rowid", (sid,)).fetchall()
        return [(role, _goose_msg_text(c)) for role, c in rows
                if role in ("user", "assistant")]
    except Exception as e:
        print(f"warn: goose messages: {e}", file=sys.stderr)
        return []
    finally:
        con.close()


def _goose_jsonl_turns(sid):
    d = _goose_dir()
    if not d:
        return None
    p = os.path.join(d, f"{sid}.jsonl")
    if not os.path.exists(p):
        return None
    turns = []
    try:
        with open(p, errors="replace") as fh:
            for line in fh:
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                if isinstance(o, dict) and o.get("role") in ("user", "assistant"):
                    turns.append((o["role"], _text_blocks(o.get("content"))))
