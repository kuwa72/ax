    count = "?"
    try:
        con = sqlite3.connect(f"file:{p}?mode=ro", uri=True)
        try:
            count = con.execute(
                "SELECT COUNT(*) FROM sessions WHERE hidden=0").fetchone()[0]
        finally:
            con.close()
    except Exception as e:
        print(f"warn: devin: {e}", file=sys.stderr)
    return {"ok": True, "count": count, "size": size}


STORE_INFO = {
    "claude": store_info_claude,
    "codex": store_info_codex,
    "agy": store_info_agy,
    "opencode": store_info_opencode,
    "devin": store_info_devin,
}


LISTERS = {"claude": list_claude, "codex": list_codex, "agy": list_agy,
           "opencode": list_opencode, "devin": list_devin}
PREVIEWERS = {"claude": preview_claude, "codex": preview_codex, "agy": preview_agy,
              "opencode": preview_opencode, "devin": preview_devin}


def collect(agents, limit, no_cache=False):
    rows = []
    for a in agents:
        try:
            rows.extend(LISTERS[a](limit=limit, no_cache=no_cache))
        except Exception as e:
            print(f"warn: {a}: {e}", file=sys.stderr)
    rows.sort(key=lambda r: r["epoch"], reverse=True)
    return rows[:limit]


def fmt_tsv(rows):
    out = []
    for r in rows:
        out.append("\t".join([r["agent"], r["id"], str(r["epoch"]),
                               reltime(r["epoch"]), short_cwd(r["cwd"]),
                               r["cwd"], r["title"]]))
    return "\n".join(out)


def cmd_list(args):
    as_json, agents, limit, no_cache = False, list(AGENTS), DEFAULT_LIMIT, False
    i = 0
    while i < len(args):
        if args[i] == "--json":
            as_json = True
        elif args[i] == "--no-cache":
            no_cache = True
        elif args[i] == "--agent" and i + 1 < len(args):
            i += 1
            agents = [args[i]] if args[i] in AGENTS else []
        elif args[i] == "--limit" and i + 1 < len(args):
            i += 1
            limit = int(args[i])
        i += 1
    rows = collect(agents, limit, no_cache=no_cache)
    if as_json:
        print(json.dumps(rows, ensure_ascii=False))
    elif rows:
        print(fmt_tsv(rows))


def cmd_preview(args):
    as_json = "--json" in args
    pos = [a for a in args if not a.startswith("-")]
    if len(pos) < 2:
        print("usage: ax preview <agent> <id>", file=sys.stderr)
        return 1
    agent, sid = pos[0], pos[1]
    if agent not in PREVIEWERS:
        print(f"unknown agent: {agent}", file=sys.stderr)
        return 1
    try:
        text = PREVIEWERS[agent](sid)
    except Exception as e:
        text = f"preview error: {e}"
    if as_json:
        print(json.dumps({"agent": agent, "id": sid, "preview": text}, ensure_ascii=False))
    else:
        print(text)


def cmd_resume(args):
    pos = [a for a in args if not a.startswith("-")]
    if len(pos) < 2:
        print("usage: ax resume <agent> <id>", file=sys.stderr)
        return 1
    agent, sid = pos[0], pos[1]
    if agent not in RESUME_CMD:
        print(f"unknown agent: {agent}", file=sys.stderr)
        return 1
    argv = RESUME_CMD[agent](sid)
    cwd = None
    for r in collect([agent], 2000):
        if r["id"] == sid:
            cwd = r["cwd"]
            break
    if cwd and os.path.isdir(cwd):
        os.chdir(cwd)
    print(f"+ cd {os.getcwd()} && {' '.join(argv)}", file=sys.stderr)
    os.execvp(argv[0], argv)


def cmd_agents():
    for a in AGENTS:
        try:
            info = STORE_INFO[a]()
        except Exception as e:
            print(f"warn: {a}: {e}", file=sys.stderr)
            info = {"ok": False}
        if info.get("ok"):
            print(f"{a}: ok ({info['count']} sessions, {human_size(info['size'])})")
        else:
            print(f"{a}: not found")


def cmd_picker():
    if not shutil.which("fzf"):
        print("ax: fzf not found in PATH", file=sys.stderr)
        return 1
    rows = collect(list(AGENTS), DEFAULT_LIMIT)
    if not rows:
        print("ax: no sessions found", file=sys.stderr)
        return 1
    tsv = fmt_tsv(rows)
    # cols: 1 agent, 2 id, 3 epoch, 4 reltime, 5 short_cwd, 6 cwd, 7 title
    fzf = ["fzf", "--delimiter", "\t",
           "--with-nth", "1,4,5,7",
           "--preview", f"{SELF} preview {{1}} {{2}}",
           "--preview-window", "right:55%:wrap",
           "--header", "claude/codex/agy/opencode/devin横断 | enter=resume esc=cancel",
           "--prompt", "ax> "]
    p = subprocess.run(fzf, input=tsv + "\n", capture_output=False,
                       text=True, stdout=subprocess.PIPE)
    sel = (p.stdout or "").strip()
    if p.returncode != 0 or not sel:
        return 0
    agent, sid = sel.split("\t")[0], sel.split("\t")[1]
    return cmd_resume([agent, sid])


def main():
    args = sys.argv[1:]
    if not args:
        return cmd_picker()
    cmd, rest = args[0], args[1:]
    if cmd == "list":
        return cmd_list(rest)
    if cmd == "preview":
        return cmd_preview(rest)
    if cmd == "resume":
        return cmd_resume(rest)
    if cmd == "agents":
        return cmd_agents()
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    print(f"unknown command: {cmd}\n{__doc__}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main() or 0)
