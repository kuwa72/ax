def grep_hermes(sid, pats_b, pat_s, query, max_hits=2):
    """Messages can carry a NUL-prefixed JSON encoding which defeats LIKE,
    so filtering is done in Python after decoding."""
    out = []
    con = _hermes_db()
    if con is None:
        return out
    try:
        cols = _table_cols(con, "messages")
        if "content" not in cols or "session_id" not in cols:
            return out
        extra = ""
        if "active" in cols:
            extra += " AND active=1"
        if "role" in cols:
            extra += " AND role IN ('user','assistant')"
        order = " ORDER BY id" if "id" in cols else " ORDER BY rowid"
        rows = con.execute(
            f"SELECT content FROM messages WHERE session_id=?{extra}{order}",
            (sid,)).fetchall()
        for (c,) in rows:
            t = _hermes_msg_text(c)
            if t and pat_s.search(t):
                out.append(_snippet(t, pat_s))
                if len(out) >= max_hits:
                    break
    except Exception:
        pass
    finally:
        con.close()
    return out


