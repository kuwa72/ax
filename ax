def _like_esc(q):
    return "%" + re.sub(r"([%_\\])", r"\\\1", q) + "%"


def _sql_text_grep(con, table, sid_col, ccol, sid, query, decode, pat_s,
                   max_hits, extra_where=""):
    """LIKE-prefilter a text/JSON column, then decode+regex for real hits."""
    likes = [_like_esc(query)]
    esc = json.dumps(query, ensure_ascii=True)[1:-1]
    if esc != query:
        likes.append(_like_esc(esc))
    where = " OR ".join(f"{ccol} LIKE ? ESCAPE '\\'" for _ in likes)
    rows = con.execute(
        f"SELECT {ccol} FROM {table} WHERE {sid_col}=?{extra_where}"
        f" AND ({where}) LIMIT ?",
        (sid, *likes, max_hits * 4)).fetchall()
    out = []
    for (c,) in rows:
        t = decode(c)
        if t and pat_s.search(t):
            out.append(_snippet(t, pat_s))
            if len(out) >= max_hits:
                break
    return out


def grep_goose(sid, pats_b, pat_s, query, max_hits=2):
    out = []
    con = _goose_db()
    if con is not None:
        try:
            cols = _table_cols(con, "messages")
            ccol = "content_json" if "content_json" in cols else \
                ("content" if "content" in cols else None)
            if ccol and "session_id" in cols:
                rc = " AND role IN ('user','assistant')" \
                    if "role" in cols else ""
                out = _sql_text_grep(con, "messages", "session_id", ccol, sid,
                                     query, _goose_msg_text, pat_s,
                                     max_hits, extra_where=rc)
        except Exception:
            pass
        finally:
            con.close()
    d = _goose_dir()
    if d and len(out) < max_hits:
        p = os.path.join(d, f"{sid}.jsonl")
        if os.path.exists(p):
            out += _grep_jsonl(p, pats_b, pat_s, _goose_text,
                               max_hits - len(out))
    return out


