def _source_fingerprint(path, suffixes=("", "-wal", "-shm")):
    fp = []
    for suffix in suffixes:
        p = path + suffix
        try:
            st = os.stat(p)
            fp.append([st.st_mtime_ns, st.st_size])
        except OSError:
            fp.append(None)
    return fp


def _load_list_cache(agent, limit, fingerprint):
    p = os.path.join(CACHE_DIR, f"{agent}.json")
    try:
        with open(p, "r", encoding="utf-8") as fh:
            c = json.load(fh)
    except (OSError, ValueError):
        return None
    if (c.get("version") != 1 or c.get("agent") != agent or
            c.get("limit") != limit or c.get("fingerprint") != fingerprint):
        return None
    rows = c.get("rows")
    if not isinstance(rows, list):
        return None
    return rows


def _save_list_cache(agent, limit, fingerprint, rows):
    p = os.path.join(CACHE_DIR, f"{agent}.json")
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(p, "w", encoding="utf-8") as fh:
        json.dump({
            "version": 1,
            "agent": agent,
            "limit": limit,
            "fingerprint": fingerprint,
            "rows": rows,
        }, fh)


