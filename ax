AGY_HOME = os.path.join(HOME, ".gemini", "antigravity-cli")


def _agy_transcript(cid):
    return os.path.join(AGY_HOME, "brain", cid, ".system_generated", "logs",
                        "transcript.jsonl")


def _agy_history():
    """conversationId -> [best_title, workspace, max_ts_ms]."""
    m = {}
    p = os.path.join(AGY_HOME, "history.jsonl")
    if not os.path.exists(p):
        return m
    with open(p, errors="replace") as fh:
        for line in fh:
            try:
                o = json.loads(line)
            except Exception:
                continue
            cid = o.get("conversationId")
            if not cid:
                continue
            disp = clean_title(re.sub(r"</?USER_REQUEST>", " ", o.get("display") or ""))
            ws = o.get("workspace", "?") or "?"
            ts = o.get("timestamp", 0) or 0
            cur = m.get(cid)
            if cur is None:
                m[cid] = [disp if not disp.startswith("/") else "", ws, ts]
            else:
                if ws != "?":
                    cur[1] = ws
                cur[2] = max(cur[2], ts)
                if disp and not disp.startswith("/") and len(disp) > len(cur[0]):
                    cur[0] = disp
    return m


def list_agy(limit=DEFAULT_LIMIT, no_cache=False):
    out = []
    conv = os.path.join(AGY_HOME, "conversations")
    if not os.path.isdir(conv):
        return out
    hist = _agy_history()
    lastmap = {}
    try:
        with open(os.path.join(AGY_HOME, "cache", "last_conversations.json")) as fh:
            lastmap = {v: k for k, v in json.load(fh).items()}
    except Exception:
        pass
    dbs = []
    with os.scandir(conv) as it:
        for f in it:
            if f.name.endswith(".db"):
                try:
                    dbs.append((f.stat().st_mtime, f.path, f.name[:-3]))
                except OSError:
                    pass
    dbs.sort(reverse=True)
    for mtime, dbp, cid in dbs[:limit]:
        h = hist.get(cid, ("", "?", 0))
        title, cwd, hts = h
        epoch = int(max(mtime, (hts or 0) / 1000))
        if cwd == "?" or not cwd:
            try:
                con = sqlite3.connect(f"file:{dbp}?mode=ro", uri=True)
                row = con.execute(
                    "SELECT data FROM trajectory_metadata_blob LIMIT 1").fetchone()
                con.close()
                if row and row[0]:
                    m_ = re.search(rb"file://([^\x00-\x1f\"']+)", bytes(row[0]))
                    if m_:
                        cwd = m_.group(1).decode("utf-8", "replace")
            except Exception:
                pass
        if (not cwd or cwd == "?") and cid in lastmap:
            cwd = lastmap[cid]
        if not title:
            title = _agy_first_input(cid)
        out.append({"agent": "agy", "id": cid, "epoch": epoch,
                    "cwd": cwd or "?", "title": title or "(no preview)"})
    return out


def _agy_first_input(cid):
    p = _agy_transcript(cid)
    if not os.path.exists(p):
        return ""
    try:
        with open(p, errors="replace") as fh:
            for i, line in enumerate(fh):
                if i > 40:
                    break
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                if o.get("type") == "USER_INPUT" and o.get("content"):
                    c = clean_title(re.sub(r"</?USER_REQUEST>", " ", o["content"]))
                    if c and not c.startswith("/"):
                        return c
    except OSError:
        pass
    return ""


def preview_agy(cid, n=None, color=None):
    n = _preview_lines("agy", n)
    p = _agy_transcript(cid)
    if not os.path.exists(p):
        return f"agy transcript not found: {cid}"
    turns = []
    with open(p, errors="replace") as fh:
        for line in fh:
            try:
                o = json.loads(line)
            except Exception:
                continue
            t = o.get("type", "")
            c = o.get("content", "") or ""
            # USER_INPUT wraps the actual prompt in <USER_REQUEST>; keep the inner text.
            # If the tag is missing, treat the whole content as the prompt.
            if t == "USER_INPUT":
                m = re.search(r"<USER_REQUEST>(.*?)</USER_REQUEST>", c,
                              flags=re.DOTALL)
                if m:
                    c = m.group(1)
            # Strip metadata blocks regardless of role.
            c = re.sub(r"<(ADDITIONAL_METADATA|USER_SETTINGS_CHANGE)>"
                       r".*?</\1>", "", c, flags=re.DOTALL)
            c = body_text(c)
            if not c:
                continue
            if t == "USER_INPUT":
                turns.append(("user", c, o.get("timestamp")))
            elif t in ("AGENT_OUTPUT", "ASSISTANT", "MODEL_OUTPUT",
                       "PLANNER_RESPONSE"):
                turns.append(("ai", c, o.get("timestamp")))
    return render_preview("agy", cid, turns[-n:], total=len(turns), color=color)


# ---------------- opencode ----------------
def _oc_db():
    p = os.path.join(HOME, ".local", "share", "opencode", "opencode.db")
    if not os.path.exists(p):
        return None
    return sqlite3.connect(f"file:{p}?mode=ro", uri=True)


def _oc_has_v2(con):
    """True if the store has migrated to the v2 schema (session_v2 table)."""
    try:
        row = con.execute(
            "SELECT name FROM sqlite_master WHERE type='table' "
            "AND name='session_v2'").fetchone()
        return row is not None
    except sqlite3.Error:
        return False


def _oc_table_cols(con, table):
    """Column names of a store table (empty set on any error)."""
    try:
        return {r[1] for r in
                con.execute(f"PRAGMA table_info({table})").fetchall()}
    except sqlite3.Error:
        return set()


def _oc_child_ids(con):
    """IDs of fork/subagent child sessions (session_v2.parent_id set)."""
    try:
        rows = con.execute(
            "SELECT id FROM session_v2 "
            "WHERE parent_id IS NOT NULL AND parent_id <> ''").fetchall()
        return {r[0] for r in rows}
    except sqlite3.Error:
        return set()


def _source_fingerprint(path, suffixes=("", "-wal", "-shm")):
    fp = []
    for suffix in suffixes:
        p = path + suffix
        try:
            st = os.stat(p)
            fp.append([st.st_mtime_ns, st.st_size])
        except OSError:
            fp.append(None)
    return fp


def _load_list_cache(agent, limit, fingerprint):
    p = os.path.join(CACHE_DIR, f"{agent}.json")
    try:
        with open(p, "r", encoding="utf-8") as fh:
            c = json.load(fh)
    except (OSError, ValueError):
        return None
    if (c.get("version") != 1 or c.get("agent") != agent or
            c.get("limit") != limit or c.get("fingerprint") != fingerprint):
        return None
    rows = c.get("rows")
    if not isinstance(rows, list):
        return None
    return rows


def _save_list_cache(agent, limit, fingerprint, rows):
    p = os.path.join(CACHE_DIR, f"{agent}.json")
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(p, "w", encoding="utf-8") as fh:
        json.dump({
            "version": 1,
            "agent": agent,
            "limit": limit,
            "fingerprint": fingerprint,
            "rows": rows,
        }, fh)


def list_opencode(limit=DEFAULT_LIMIT, no_cache=False):
    p = os.path.join(HOME, ".local", "share", "opencode", "opencode.db")
    if not os.path.exists(p):
        return []
    fingerprint = _source_fingerprint(p)
    if not no_cache:
        cached = _load_list_cache("opencode", limit, fingerprint)
        if cached is not None:
            return cached
    con = _oc_db()
    if con is None:
        return []
    rows = []
    try:
        if _oc_has_v2(con):
            # v2.0.x schema: session_v2 holds every session (migrated v1 rows
            # are copied there, so it is a superset). Read it, and union with
            # the legacy table in case a store still carries v1-only rows.
            # The LIMIT applies to the combined result.
            # Fork/subagent child sessions (session_v2.parent_id set) are
            # hidden from listings (#36); direct preview by ID still works.
            child_ids = _oc_child_ids(con)
            legacy_parent = "parent_id" in _oc_table_cols(con, "session")
            for sid, d, title, tu in con.execute(
                    "SELECT id, directory, title, time_updated FROM session_v2 "
                    "WHERE id NOT IN (SELECT id FROM session) "
                    "AND (parent_id IS NULL OR parent_id = '') "
                    "ORDER BY time_updated DESC LIMIT ?", (limit,)):
                rows.append({"agent": "opencode", "id": sid,
                             "epoch": int((tu or 0) // 1000),
                             "cwd": d or "?", "title": (title or "").strip() or "(untitled)"})
            if legacy_parent:
                q = ("SELECT id, directory, title, time_updated FROM session "
                     "WHERE (parent_id IS NULL OR parent_id = '') "
                     "ORDER BY time_updated DESC LIMIT ?")
            else:
                q = ("SELECT id, directory, title, time_updated FROM session "
                     "ORDER BY time_updated DESC LIMIT ?")
            for sid, d, title, tu in con.execute(q, (limit,)):
                if sid in child_ids:
                    continue
                rows.append({"agent": "opencode", "id": sid,
                             "epoch": int((tu or 0) // 1000),
                             "cwd": d or "?", "title": (title or "").strip() or "(untitled)"})
            rows.sort(key=lambda r: r["epoch"], reverse=True)
            rows = rows[:limit]
        else:
            if "parent_id" in _oc_table_cols(con, "session"):
                q = ("SELECT id, directory, title, time_updated FROM session "
                     "WHERE (parent_id IS NULL OR parent_id = '') "
                     "ORDER BY time_updated DESC LIMIT ?")
            else:
                q = ("SELECT id, directory, title, time_updated FROM session "
                     "ORDER BY time_updated DESC LIMIT ?")
            for sid, d, title, tu in con.execute(q, (limit,)):
                rows.append({"agent": "opencode", "id": sid, "epoch": int((tu or 0) // 1000),
                             "cwd": d or "?", "title": (title or "").strip() or "(untitled)"})
    finally:
        con.close()
    _save_list_cache("opencode", limit, fingerprint, rows)
    return rows


def preview_opencode(sid, n=None, color=None):
    n = _preview_lines("opencode", n)
    try:
        con = _oc_db()
        if con is None:
            return f"opencode session not found: {sid}"
        use_v2 = _oc_has_v2(con)
        rows = []
        if use_v2:
            rows = con.execute(
                "SELECT type, data, time_created FROM session_message "
                "WHERE session_id=? AND type IN ('user','assistant') "
                "ORDER BY time_created DESC LIMIT ?",
                (sid, n)).fetchall()
        if not rows:
            try:
                rows = con.execute(
                    "SELECT p.data, p.time_created, m.data FROM part p "
                    "LEFT JOIN message m ON m.id = p.message_id "
                    "WHERE p.session_id=? ORDER BY p.time_created DESC LIMIT ?",
                    (sid, n)).fetchall()
            except sqlite3.Error:
                # older/simplified stores without a message table
                rows = [(d, None, None) for (d,) in con.execute(
                    "SELECT data FROM part WHERE session_id=? "
                    "ORDER BY time_created DESC LIMIT ?", (sid, n)).fetchall()]
            use_v2 = False
        con.close()
    except Exception as e:
        return f"opencode read error: {e}"
    turns = []
    if use_v2:
        for typ, d, ts in reversed(rows):
            try:
                o = json.loads(d) if isinstance(d, str) else d
            except Exception:
                continue
            if not isinstance(o, dict):
                continue
            role = "user" if typ == "user" else "assistant"
            if typ == "user":
                txt = body_text(o.get("text", ""))
            else:
                chunks = []
                for c in (o.get("content") or []):
                    if isinstance(c, dict) and c.get("type") == "text":
                        t = body_text(c.get("text", ""))
                        if t:
                            chunks.append(t)
                txt = "\n".join(chunks)
            if not txt:
                continue
            turns.append((_role_label(role), txt, ts))
        return render_preview("opencode", sid, turns, total=len(turns),
                              color=color)
    for d, ts, md in reversed(rows):
        try:
            o = json.loads(d) if isinstance(d, str) else d
        except Exception:
            continue
        if not (isinstance(o, dict) and o.get("type") == "text"):
            continue
        txt = body_text(o.get("text", ""))
        if not txt:
            continue
        role = "msg"
        try:
            mo = json.loads(md) if isinstance(md, str) else md
            if isinstance(mo, dict) and mo.get("role"):
                role = mo["role"]
        except Exception:
            pass
        turns.append((_role_label(role), txt, ts))
    return render_preview("opencode", sid, turns, total=len(turns), color=color)


# ---------------- devin ----------------
DEVIN_PREVIEW_PROMPT = "/_ax_preview"


def _devin_db():
    p = os.path.join(HOME, ".local", "share", "devin", "cli", "sessions.db")
    if not os.path.exists(p):
        return None
    return sqlite3.connect(f"file:{p}?mode=ro", uri=True)


def _devin_transcript_path(sid):
    return os.path.join(HOME, ".local", "share", "devin", "cli", "transcripts", sid + ".json")


def _devin_cache_path(sid):
    return os.path.join(CACHE_DIR, "devin", sid + ".json")


def _devin_message_text(msg):
    if isinstance(msg, str):
        return clean_title(msg, 300)
    if isinstance(msg, list):
        parts = []
        for part in msg:
            if isinstance(part, dict):
                if part.get("type") in ("text", "input_text", "output_text"):
                    parts.append(part.get("text", ""))
                else:
                    parts.append(str(part))
            else:
                parts.append(str(part))
        return clean_title("".join(parts), 300)
    return ""


def _devin_step_text(step):
    if not isinstance(step, dict):
        return None
    source = step.get("source", "")
    if source in ("system", "tool"):
        return None
    if source not in ("user", "agent", "assistant"):
        return None
    label = _role_label(source)
    text = _devin_message_text(step.get("message", ""))
    if not text:
        return None
    return f"[{label}] {text}"


def _devin_trim_sentinel(steps, sentinel):
    if not steps or len(steps) < 2:
        return steps
    last = steps[-1]
    prev = steps[-2]
    if (isinstance(last, dict)
            and last.get("source") in ("agent", "assistant")
            and isinstance(last.get("message"), str)
            and last["message"].startswith("Unknown command:")):
        if (isinstance(prev, dict)
                and prev.get("source") == "user"
                and prev.get("message") == sentinel):
            return steps[:-2]
    return steps


def _devin_lines_from_steps(steps, trim_sentinel=None):
    if trim_sentinel:
        steps = _devin_trim_sentinel(steps, trim_sentinel)
    lines = []
    for s in steps:
        line = _devin_step_text(s)
        if line:
            lines.append(line)
    return lines


def _parse_devin_export(path, trim_sentinel=None):
    with open(path, errors="replace") as fh:
        d = json.load(fh)
    steps = d.get("steps", []) if isinstance(d, dict) else []
    lines = _devin_lines_from_steps(steps, trim_sentinel)
    return d, lines


def _devin_db_messages(sid):
    con = _devin_db()
    if con is None:
        return None
    try:
        row = con.execute(
            "SELECT main_chain_id, model FROM sessions WHERE id=?", (sid,)
        ).fetchone()
        if not row:
            con.close()
            return None
        main_chain_id, model = row[0], row[1] or "?"
        rows = con.execute(
            "SELECT node_id, parent_node_id, chat_message "
            "FROM message_nodes WHERE session_id=?", (sid,)
        ).fetchall()
        con.close()
        if not rows or main_chain_id is None:
            return None
        node_map = {}
        for node_id, parent_id, raw in rows:
            try:
                msg = json.loads(raw)
            except Exception:
                msg = {}
            node_map[node_id] = (parent_id, msg)
        chain = []
        seen = set()
        cur = main_chain_id
        while cur is not None and cur not in seen:
            seen.add(cur)
            chain.append(cur)
            parent, _ = node_map.get(cur, (None, None))
            cur = parent
        chain.reverse()
        lines = []
        for node_id in chain:
            _, msg = node_map.get(node_id, (None, None))
            if not isinstance(msg, dict):
                continue
            role = msg.get("role", "")
            if role in ("system", "tool"):
                continue
            label = _role_label(role)
            text = _devin_message_text(msg.get("content"))
            if text:
                lines.append(f"[{label}] {text}")
        return lines, model
    except Exception:
        return None


def _devin_title(sid):
    con = _devin_db()
    if con is None:
        return ""
    try:
        row = con.execute("SELECT title FROM sessions WHERE id=?", (sid,)).fetchone()
        con.close()
        if row and row[0]:
            return row[0].strip()
    except Exception:
        pass
    return ""


def _devin_run_export(sid, out_path, timeout=15):
    import shutil
    devin = shutil.which("devin")
    if not devin:
        raise FileNotFoundError("devin not found")
    cmd = [devin, "-r", sid, "-p", DEVIN_PREVIEW_PROMPT, "--export", out_path,
           "--respect-workspace-trust", "false"]
    proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True)
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        out, err = proc.communicate()
        raise RuntimeError(f"devin timed out: {err}")
    if proc.returncode != 0:
        raise RuntimeError(f"devin failed ({proc.returncode}): {err}")
    if not os.path.exists(out_path):
        raise RuntimeError(f"devin did not write export: {err}")


def _devin_try_export(sid, cache_path, n=20):
    fd, tmp = tempfile.mkstemp(suffix=".json", prefix="ax-devin-")
    os.close(fd)
    try:
        _devin_run_export(sid, tmp, timeout=15)
        d, lines = _parse_devin_export(tmp, trim_sentinel=DEVIN_PREVIEW_PROMPT)
        if not lines:
            return None
        # Cache the fetched transcript for future previews.
        try:
            os.makedirs(os.path.dirname(cache_path), exist_ok=True)
            shutil.copy(tmp, cache_path)
        except Exception:
            pass
        model = d.get("agent", {}).get("model_name", "?")
        return model, len(d.get("steps", [])), lines[-n:]
    except Exception as e:
        print(f"warn: devin export failed for {sid}: {e}", file=sys.stderr)
        return None
    finally:
        try:
            os.remove(tmp)
        except Exception:
            pass


def list_devin(limit=DEFAULT_LIMIT, no_cache=False):
    out = []
    try:
        con = _devin_db()
        if con is None:
            return out
        for sid, wd, title, la in con.execute(
                "SELECT id, working_directory, title, last_activity_at FROM sessions "
                "WHERE hidden=0 ORDER BY last_activity_at DESC LIMIT ?", (limit,)):
            out.append({"agent": "devin", "id": sid, "epoch": int(la or 0),
                        "cwd": wd or "?", "title": (title or "").strip() or "(untitled)"})
        con.close()
    except Exception:
        pass
    return out


def _devin_lines_to_turns(lines):
    turns = []
    for line in lines or []:
        m = re.match(r"^\[([^\]]+)\]\s(.*)$", line)
        if m:
            turns.append((m.group(1), m.group(2)))
    return turns


def preview_devin(sid, n=None, color=None):
    n = _preview_lines("devin", n)
    resume = f"resume: devin -r {sid}"
    local_path = _devin_transcript_path(sid)
    cache_path = _devin_cache_path(sid)

    def _render(total, lines, model, source):
        turns = _devin_lines_to_turns(lines)
        if not turns:
            return None
        info = f"model={model} steps={total} source={source}"
        return render_preview("devin", sid, turns[-n:], total=total,
                              extra=[resume, info], color=color)

    # 1. Local ATIF transcript.
    if os.path.exists(local_path):
        try:
            d, lines = _parse_devin_export(local_path)
            out = _render(len(d.get("steps", [])), lines,
                          d.get("agent", {}).get("model_name", "?"), "local")
            if out:
                return out
        except Exception:
            pass

    # 2. Cached export from a previous fallback.
    if os.path.exists(cache_path):
        try:
            d, lines = _parse_devin_export(cache_path)
            out = _render(len(d.get("steps", [])), lines,
                          d.get("agent", {}).get("model_name", "?"), "cache")
            if out:
                return out
        except Exception:
            pass

    # 3. Try devin --export to fetch from the cloud.
    result = _devin_try_export(sid, cache_path, n=n)
    if result:
        model, steps, lines = result
        out = _render(steps, lines, model, "export")
        if out:
            return out

    # 4. Fall back to the local sessions.db message_nodes tree.
    db_result = _devin_db_messages(sid)
    if db_result:
        lines, model = db_result
        out = _render(len(lines), lines, model, "db")
        if out:
            return out

    # 5. Final fallback: show the session title if known.
    title = _devin_title(sid)
    if title:
        return f"--- devin {sid} (0 msgs)\n{resume}\ntitle={title} (no local transcript)"
    return f"--- devin {sid} (0 msgs)\n{resume}\n(no local transcript)"


# ---------------- aider ----------------
# aider has no session ids or central store: it appends to
# <repo>/.aider.chat.history.md. ax rows are history files; resume runs
# `aider --restore-chat-history` in the repo dir.
AIDER_HISTORY = ".aider.chat.history.md"
_AIDER_SKIP_DIRS = {"node_modules", "__pycache__", "venv", "target", "dist",
                    "build", "go"}
AIDER_SCAN_MAX_DEPTH = 8


def _aider_roots():
    roots = CONFIG["providers"]["aider"]["roots"]
    seen = set()
    out = []
    for r in list(roots) + [os.getcwd()]:
        if r == "~" or r.startswith("~/"):
            r = HOME + r[1:]
        p = os.path.abspath(os.path.expanduser(r))
        if p not in seen and os.path.isdir(p):
            seen.add(p)
            out.append(p)
    return out


def _aider_scan():
    """Yield .aider.chat.history.md paths under configured roots. Hidden and
    heavy dirs are pruned; depth is capped so a HOME root stays cheap."""
    for root in _aider_roots():
        root_depth = root.rstrip(os.sep).count(os.sep)
        for dp, dns, fns in os.walk(root):
            if dp.rstrip(os.sep).count(os.sep) - root_depth >= AIDER_SCAN_MAX_DEPTH:
                dns[:] = []
                continue
            dns[:] = [d for d in dns
                      if not d.startswith(".") and d not in _AIDER_SKIP_DIRS]
            if AIDER_HISTORY in fns:
                yield os.path.join(dp, AIDER_HISTORY)


_AIDER_HEADER_RE = re.compile(r"^# aider chat started at (.+)$")


def _aider_turns(path):
    """Parse a history file into [(role, text)] and block start epochs.
    `#### ` lines are user input, `> ` lines are tool output (skipped),
    bare text is assistant output; ``` fences are tracked so markers inside
    code blocks are not mistaken for roles."""
    turns, starts = [], []
    role, buf, in_fence = None, [], False

    def flush():
        nonlocal role, buf
        text = "\n".join(buf).strip()
        if role and text:
            turns.append((role, text))
        role, buf = None, []

    try:
        with open(path, errors="replace") as fh:
            for line in fh.read().splitlines():
                if line.startswith("```"):
                    in_fence = not in_fence
                if not in_fence:
                    m = _AIDER_HEADER_RE.match(line)
                    if m:
                        flush()
                        starts.append(_epoch_from_ts(m.group(1).strip()))
                        continue
                    if line.startswith("#### "):
                        if role != "user":
                            flush()
                            role = "user"
                        buf.append(line[5:])
                        continue
                    if line.startswith("> "):
                        continue
                if role is None:
                    role = "assistant"
                elif role == "user":
                    flush()
                    role = "assistant"
                buf.append(line)
        flush()
    except OSError:
        pass
    return turns, starts


def list_aider(limit=DEFAULT_LIMIT, no_cache=False):
    out = []
    for path in _aider_scan():
        turns, starts = _aider_turns(path)
        epoch = starts[-1] if starts else 0
        if not epoch:
            try:
                epoch = int(os.path.getmtime(path))
            except OSError:
                continue
        title = ""
        for r, t in reversed(turns):
            if r == "user":
                title = clean_title(t)
                break
        out.append({"agent": "aider", "id": path, "epoch": epoch,
                    "cwd": os.path.dirname(path),
                    "title": title or "(untitled)"})
    out.sort(key=lambda r: r["epoch"], reverse=True)
    return out[:limit]


def preview_aider(sid, n=None, color=None):
    n = _preview_lines("aider", n)
    if not os.path.exists(sid):
        return f"aider session not found: {sid}"
    turns, starts = _aider_turns(sid)
    extra = [f"resume: cd {os.path.dirname(sid)} && aider --restore-chat-history"]
    if starts:
        extra.append(f"blocks={len(starts)}")
    return render_preview("aider", sid, turns[-n:], extra=extra,
                          total=len(turns), color=color)


